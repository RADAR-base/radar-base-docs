{
  "name": "radar-base-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Aggregated documentation site for the RADAR-base platform",
  "scripts": {
    "fetch-docs": "node scripts/fetch-docs.mjs",
    "start": "npm run fetch-docs && docusaurus start",
    "start:offline": "docusaurus start",
    "build": "npm run fetch-docs && docusaurus build",
    "serve": "docusaurus serve",
    "docusaurus": "docusaurus",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear && rm -rf .generated .cache docs *_versioned_docs *_versioned_sidebars *_versions.json"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "js-yaml": "^5.2.3",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
